---
/** The page shell every page uses: document head, header, main landmark and footer. */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
// The two faces every page opens with, fetched early so headlines do not wait on the stylesheet.
import labelFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import displayFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { site } from '@/data/site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  /** Meta description; defaults to the site's. */
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);

/** Browser UI color; the same value as --color-bg in tokens.css (meta tags cannot read CSS). */
const themeColor = '#e6e5df';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={themeColor} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={labelFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.role}, ${site.affiliation}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/*
     * Lets content marked `data-reveal` rise into view as the page scrolls (styles in
     * global.css, which leave everything visible without scripts or with reduced motion).
     * Inline, so the content it hides can never be left waiting on a script that failed to
     * download.
     */}
    <script is:inline>
      (() => {
        const targets = document.querySelectorAll('[data-reveal]');
        if (targets.length === 0) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          // A little before the element's top edge clears the foot of the window.
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        for (const target of targets) observer.observe(target);
      })();
    </script>
  </body>
</html>
