---
/**
 * A titled part of a page: its `h2` over the slotted content, labelled for screen readers. It
 * adds no width or outer spacing; the page places it.
 */
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  /** Anchor for in-page links; the heading's id is `<id>-title`. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <SectionHeading id={`${id}-title`} title={title} />
  <slot />
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-content: start;
  }

  /* Chromium can overlap grid items that avoid page breaks, so paper gets plain blocks. */
  @media print {
    .section {
      display: block;
      margin-bottom: var(--space-7);
    }
  }
</style>
