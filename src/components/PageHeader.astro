---
/**
 * The top of an inner page: a legend, the page's h1 at display size, an optional lede (default
 * slot) and an optional row of actions (`actions` slot, e.g. ButtonLinks).
 */
import SectionLabel from '@/components/SectionLabel.astro';

interface Props {
  title: string;
  kicker?: string;
}

const { title, kicker } = Astro.props;
---

<header class="page-header">
  {kicker && <SectionLabel label={kicker} />}
  <h1>{title}</h1>
  {Astro.slots.has('default') && (
    <div class="lede">
      <slot />
    </div>
  )}
  {Astro.slots.has('actions') && (
    <div class="actions">
      <slot name="actions" />
    </div>
  )}
</header>

<style>
  .page-header {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-8);
  }

  h1 {
    max-width: 14ch;
    margin-top: var(--space-4);
    font-size: var(--text-display);
    font-weight: 330;
    line-height: var(--leading-display);
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: var(--width-prose);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media print {
    .page-header {
      padding-block: 0 var(--space-5);
    }

    h1 {
      margin-top: 0;
    }
  }
</style>
