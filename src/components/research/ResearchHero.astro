---
/**
 * The opening of the research page: the headline at display size, the introduction, and the key
 * to the colors every scene below uses.
 */
import SectionLabel from '@/components/SectionLabel.astro';
import ColorLegend from './ColorLegend.astro';

interface Props {
  label: string;
  title: string;
  lede: readonly string[];
  legend: { signal: string; spike: string; decode: string };
}

const { label, title, lede, legend } = Astro.props;
---

<header class="hero container">
  <SectionLabel label={label} />
  <h1>{title}</h1>
  <div class="below">
    <div class="lede">
      {lede.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <ColorLegend legend={legend} />
  </div>
</header>

<style>
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-8);
  }

  h1 {
    max-width: 12ch;
    font-size: var(--text-display);
    font-weight: 330;
    line-height: var(--leading-display);
    letter-spacing: -0.03em;
  }

  .below {
    display: grid;
    gap: var(--space-6);
  }

  .lede {
    display: grid;
    gap: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .lede {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
      max-width: 72rem;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: var(--space-7) var(--space-9);
    }
  }
</style>
