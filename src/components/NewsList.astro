---
/**
 * Dated highlights, newest first, as given, set like a log: the date read off at the left, the
 * entry beside it. An item with a link links its whole text.
 */
import Icon from '@/components/Icon.astro';
import type { NewsItem } from '@/data/types';
import { formatMonth } from '@/lib/dates';

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ol class="news">
  {items.map(({ date, text, href }, index) => (
    <li data-reveal style={`--reveal-order: ${index}`}>
      <time class="readout" datetime={date}>
        {formatMonth(date)}
      </time>
      {href ? (
        <a href={href}>
          {text}
          <span class="arrow">
            <Icon name={isExternal(href) ? 'arrow-up-right' : 'arrow-right'} />
          </span>
        </a>
      ) : (
        <p>{text}</p>
      )}
    </li>
  ))}
</ol>

<style>
  .news {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    line-height: var(--leading-snug);
  }

  li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  time {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.9;
  }

  a {
    text-decoration-color: transparent;
  }

  a:hover {
    text-decoration-color: var(--color-accent);
  }

  .arrow {
    display: inline-flex;
    margin-inline-start: var(--space-1);
    color: var(--color-accent);
    vertical-align: -0.125em;
  }

  @media (min-width: 40rem) {
    li {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>
